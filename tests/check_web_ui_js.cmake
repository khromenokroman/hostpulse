# Вынимает <script> из src/web_ui.h и проверяет синтаксис через node --check
file(READ "${SRC}" content)
string(FIND "${content}" "<script>" begin)
string(FIND "${content}" "</script>" end)
if(begin EQUAL -1 OR end EQUAL -1)
    message(FATAL_ERROR "В ${SRC} не найден блок <script>")
endif()
math(EXPR begin "${begin} + 8")
math(EXPR len "${end} - ${begin}")
string(SUBSTRING "${content}" ${begin} ${len} script)
file(WRITE "${OUT}" "${script}")
execute_process(COMMAND "${NODE}" --check "${OUT}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Синтаксическая ошибка в JS дашборда (${OUT}):\n${err}")
endif()
