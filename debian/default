# Параметры службы hostpulse. После изменения: systemctl restart hostpulse
#
# --host 0.0.0.0    дашборд доступен из локальной сети; входа по паролю нет, поэтому
#                   любой в сети увидит модель компьютера, MAC-адреса и загрузку
# --host 127.0.0.1  только с этой машины
# --port            порт HTTP
HOSTPULSE_OPTS="--host 0.0.0.0 --port 8080"
